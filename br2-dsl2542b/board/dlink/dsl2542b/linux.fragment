# Kernel configuration fragment applied on top of arch/mips/configs/bcm63xx_defconfig.
# Buildroot: BR2_LINUX_KERNEL_DEFCONFIG="bcm63xx" + BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES.
#
# Rule: the mainline defconfig is "a sensible start for the whole BCM63xx
# family", and this file holds only the DIFFERENCES needed for the DSL-2542B
# (BCM6338, 16 MB RAM).

# --- Only our SoC (smaller kernel) ---
CONFIG_BCM63XX_CPU_6338=y
# CONFIG_BCM63XX_CPU_6345 is not set
# CONFIG_BCM63XX_CPU_6348 is not set
# CONFIG_BCM63XX_CPU_6358 is not set

# --- Disable what the board does not have ---
# CONFIG_PCI is not set
# CONFIG_PCCARD is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_MODULES is not set

# --- Leftovers from wireless in bcm63xx_defconfig ---
# Buildroot first expands bcm63xx_defconfig into a full .config and only then
# applies this fragment. In the full .config, CFG80211=y has already used
# "select" to set KEYS, SYSTEM_TRUSTED_KEYRING, crypto, etc., and those values
# are saved like ordinary settings. Disabling CFG80211 does not undo them.
# SYSTEM_TRUSTED_KEYRING builds certs/extract-cert, which needs the host's
# OpenSSL headers ("openssl/bio.h: No such file or directory").
# CONFIG_KEYS is not set
# CONFIG_CRYPTO is not set
# CONFIG_BCMA is not set
# CONFIG_NLS is not set
# CONFIG_CORDIC is not set

# --- Size matters: 16 MB RAM, 4 MB flash ---
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_IPV6 is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_KALLSYMS is not set

# --- Userspace requirements (uClibc-ng + BusyBox) ---
# bcm63xx_defconfig disables these to save space, but a libc with NPTL threads
# needs futexes, and Buildroot's init scripts mount tmpfs and devtmpfs.
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y
CONFIG_PACKET=y

# --- initramfs: rootfs built into the kernel, uncompressed ---
# The LZMA loader compresses the whole image anyway, so a second compression
# would only slow down booting.
#
# Buildroot sets INITRAMFS_SOURCE itself too, but only AFTER the first
# "olddefconfig". Without this line the compression choice below would be
# invisible (it depends on a non-empty INITRAMFS_SOURCE), olddefconfig would
# drop it, and the kernel would fall back to the default gzip.
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="${BR_BINARIES_DIR}/rootfs.cpio"
CONFIG_INITRAMFS_COMPRESSION_NONE=y

# --- Boot diagnostics on the UART ---
CONFIG_EARLY_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y

# --- LEDs (the 96338W board registers them in board_bcm963xx.c) ---
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_NETDEV=y
