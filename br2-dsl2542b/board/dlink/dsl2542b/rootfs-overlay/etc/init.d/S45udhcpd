#!/bin/sh
#
# Starts the BusyBox DHCP server on the configuration port (after S40network
# has configured eth0 with 192.168.15.1).

CONF=/etc/udhcpd.conf
PIDFILE=/var/run/udhcpd.pid

start() {
	printf "Starting udhcpd: "
	# The lease file must exist; /var lives in RAM, so create it every boot.
	mkdir -p /var/lib/misc
	touch /var/lib/misc/udhcpd.leases
	start-stop-daemon -S -q -p "$PIDFILE" --exec /usr/sbin/udhcpd -- -S "$CONF"
	[ $? = 0 ] && echo "OK" || echo "FAIL"
}

stop() {
	printf "Stopping udhcpd: "
	start-stop-daemon -K -q -p "$PIDFILE"
	[ $? = 0 ] && echo "OK" || echo "FAIL"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
