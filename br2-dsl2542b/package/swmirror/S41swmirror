#!/bin/sh
#
# Enables port mirroring in the switch according to /etc/swmirror.conf.
# S41 = runs after networking (S40network), although mirroring works
# regardless of whether eth0 is up.

CONF=/etc/swmirror.conf
MIRROR_ENABLE=no
MIRROR_DIR=both
[ -r "$CONF" ] && . "$CONF"

start() {
	[ "$MIRROR_ENABLE" = yes ] || return 0
	printf "Starting port mirroring (%s -> %s, %s): " \
		"$MIRROR_FROM" "$MIRROR_TO" "$MIRROR_DIR"
	if swmirror on "$MIRROR_TO" "$MIRROR_FROM" "$MIRROR_DIR" >/dev/null; then
		echo "OK"
	else
		echo "FAIL"
		return 1
	fi
}

stop() {
	printf "Stopping port mirroring: "
	if swmirror off; then echo "OK"; else echo "FAIL"; return 1; fi
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
