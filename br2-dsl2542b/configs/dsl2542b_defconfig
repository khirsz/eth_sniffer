# D-Link DSL-2542B: BCM6338 (BMIPS3300), 16 MB RAM, 4 MB NOR, switch BCM5325E
#
# Usage:
#   make BR2_EXTERNAL=/path/to/br2-dsl2542b dsl2542b_defconfig
#   make

# --- Architecture ---
# BMIPS3300 = MIPS32 release 1, big-endian, no FPU (soft-float).
BR2_mips=y
BR2_mips_32=y
BR2_MIPS_SOFT_FLOAT=y

# --- Toolchain built by Buildroot ---
# uClibc-ng: a small libc, a good fit for 16 MB of RAM.
BR2_TOOLCHAIN_BUILDROOT_UCLIBC=y
# Kernel headers for the libc = same version as the kernel being built.
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_OPTIMIZE_S=y

# --- System ---
BR2_TARGET_GENERIC_HOSTNAME="dsl2542b"
BR2_TARGET_GENERIC_ISSUE="DSL-2542B / Buildroot"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_SYSTEM_DHCP=""
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_DSL2542B_PATH)/board/dlink/dsl2542b/rootfs-overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_DSL2542B_PATH)/board/dlink/dsl2542b/post-image.sh"
# Default root password (needed for SSH: dropbear rejects empty passwords).
# Buildroot hashes it with mkpasswd into /etc/shadow.
BR2_TARGET_ENABLE_ROOT_LOGIN=y
BR2_TARGET_GENERIC_ROOT_PASSWD="root"

# --- BusyBox: add udhcpd (DHCP server for the configuration port) ---
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_DSL2542B_PATH)/board/dlink/dsl2542b/busybox.fragment"

# --- SSH server ---
# dropbear: small SSH server; host keys are generated on the first
# connection (-R in S50dropbear), so in RAM they change at every boot.
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y

# --- Kernel ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.91"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="bcm63xx"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_DSL2542B_PATH)/board/dlink/dsl2542b/linux.fragment"
# Raw image (objcopy -O binary of vmlinux); post-image.sh compresses it
# and wraps it in a loader that CFE understands.
BR2_LINUX_KERNEL_VMLINUX_BIN=y

# --- Filesystem: initramfs built into the kernel ---
BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_ROOTFS_TAR is not set

# --- Our packages ---
BR2_PACKAGE_SWMIRROR=y

# --- Host tools for the flash image (post-image.sh) ---
# lzma_alone (LZMA SDK): CFE's decompressor wants a 4 MB dictionary and no
# end marker, which xz cannot produce (same parameters as OpenWrt).
BR2_PACKAGE_HOST_LZMA_ALONE=y
# imagetag (OpenWrt firmware-utils): the 256-byte Broadcom tag CFE checks
# before flashing and reads at boot to find the kernel.
BR2_PACKAGE_HOST_FIRMWARE_UTILS=y
